# Database (MongoDB Atlas)
MONGODB_URI=
MONGODB_DB_NAME=family_recipes

# Authentication
JWT_SECRET=
OWNER_EMAIL=
RESEND_API_KEY=

# Logging
LOG_LEVEL=debug

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# External Tools (for AI agent access)
VERCEL_TOKEN=
GITHUB_TOKEN=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# Recipe Sync
RECIPES_DIRECTORY=recipes
RECIPE_SYNC_SECRET=

# MCP auth (mcp-auth migration; see docs/MCP.md)
# Leave unset to stay in `legacy` mode (Family Recipes as its own OAuth AS).
# Set MCP_RESOURCE_URL to switch to `mcp-auth` mode.
# MCP_AUTH_MODE=mcp-auth
# MCP_RESOURCE_URL=https://recipes.tarvy.dev/mcp
# MCP_AUTH_ISSUER_URL=https://auth.tarvy.dev
# MCP_AUTH_JWKS_URI=
